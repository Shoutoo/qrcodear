# EduAR Platform Environment Configuration Template

# PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/eduar_dev?schema=public"

# Auth / JWT
JWT_SECRET="your-jwt-secret-key"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="eduar-assets"
R2_PUBLIC_URL_BASE="https://pub-your-r2-bucket.r2.dev"
